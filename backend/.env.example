PORT=5000
NODE_ENV=production

# Database Connection (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@[DB_HOST]:5432/postgres
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.[PROJECT_REF]
DB_PASSWORD=your_secure_db_password
DB_NAME=postgres
DB_SSL=true

# Authentication & Security
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=your_secure_random_base64_or_hex_jwt_secret_min_32_chars

# Integration Secret Encryption Key (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=your_64_character_hex_encryption_key_here

# Allowed Frontend Origin (for CORS)
FRONTEND_URL=https://your-frontend-domain.vercel.app
