{
  "name": "optivir-crm",
  "version": "1.0.0",
  "private": true,
  "description": "OptiVir CRM - Enterprise Agency Operating System",
  "scripts": {
    "postinstall": "npm --prefix backend install && npm --prefix backend run build",
